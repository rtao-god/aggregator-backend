+using Aggregator.Query.Domain;
+
+namespace Query.Domain.Tests;
+
+public sealed class QueryVisibilitySafetyFilterTests
+{
+    private static readonly DateTimeOffset Timestamp =
+        new(2026, 8, 6, 8, 0, 0, TimeSpan.Zero);
+
+    [Fact]
+    public void ChildSuppressionsRemoveOnlyExactContactAndMediaIdentities()
+    {
+        var suppressedContactId = Guid.Parse("0198fb00-0000-7000-8000-000000000001");
+        var retainedContactId = Guid.Parse("0198fb00-0000-7000-8000-000000000002");
+        var suppressedMediaId = Guid.Parse("0198fb00-0000-7000-8000-000000000003");
+        var retainedMediaId = Guid.Parse("0198fb00-0000-7000-8000-000000000004");
+        var document = CreateDocument(
+            [
+                new QueryContactDocument(
+                    suppressedContactId,
+                    QueryContactKind.Phone,
+                    "tel:+4930123456",
+                    "Studio"),
+                new QueryContactDocument(
+                    retainedContactId,
+                    QueryContactKind.Website,
+                    "https://example.test",
+                    null),
+            ],
+            [
+                CreateMedia(suppressedMediaId),
+                CreateMedia(retainedMediaId),
+            ]);
+        var filter = QueryVisibilitySafetyFilter.Create(
+            [
+                CreateChildSuppression(
+                    Guid.Parse("0198fb00-0000-7000-8000-000000000010"),
+                    QueryVisibilitySuppressionTargetKind.Contact,
+                    suppressedContactId),
+                CreateChildSuppression(
+                    Guid.Parse("0198fb00-0000-7000-8000-000000000011"),
+                    QueryVisibilitySuppressionTargetKind.Media,
+                    suppressedMediaId),
+            ]);
+
+        var filtered = filter.FilterChildren(document);
+
+        Assert.Equal(retainedContactId, Assert.Single(filtered.Contacts).ContactId);
+        Assert.Equal(retainedMediaId, Assert.Single(filtered.Media).MediaId);
+        Assert.Equal(2, document.Contacts.Count);
+        Assert.Equal(2, document.Media.Count);
+    }
+
+    [Fact]
+    public void ConflictingResponseModesForOneTargetAreRejected()
+    {
+        var listingId = Guid.Parse("0198fb00-0000-7000-8000-000000000020");
+        var first = CreateListingSuppression(
+            Guid.Parse("0198fb00-0000-7000-8000-000000000021"),
+            listingId,
+            QueryVisibilitySuppressionResponseMode.Gone);
+        var second = CreateListingSuppression(
+            Guid.Parse("0198fb00-0000-7000-8000-000000000022"),
+            listingId,
+            QueryVisibilitySuppressionResponseMode.HideAsNotFound);
+
+        var exception = Assert.Throws<QueryDomainException>(() =>
+            QueryVisibilitySafetyFilter.Create([first, second]));
+
+        Assert.Equal("QUERY_VISIBILITY_TARGET_RESPONSE_CONFLICT", exception.Code);
+    }
+
+    private static QueryVisibilitySuppression CreateChildSuppression(
+        Guid suppressionId,
+        QueryVisibilitySuppressionTargetKind targetKind,
+        Guid targetId) =>
+        QueryVisibilitySuppression.Create(
+            suppressionId,
+            "berlin-recording-services",
+            targetKind,
+            listingId: null,
+            targetId.ToString("D"),
+            "privacy-request",
+            QueryVisibilitySuppressionResponseMode.OmitChildElement,
+            QueryVisibilitySuppressionState.Active,
+            Timestamp,
+            expiresAtUtc: null,
+            aggregateRevision: 2,
+            Timestamp);
+
+    private static QueryVisibilitySuppression CreateListingSuppression(
+        Guid suppressionId,
+        Guid listingId,
+        QueryVisibilitySuppressionResponseMode responseMode) =>
+        QueryVisibilitySuppression.Create(
+            suppressionId,
+            "berlin-recording-services",
+            QueryVisibilitySuppressionTargetKind.Listing,
+            listingId,
+            listingId.ToString("D"),
+            "legal-removal",
+            responseMode,
+            QueryVisibilitySuppressionState.Active,
+            Timestamp,
+            expiresAtUtc: null,
+            aggregateRevision: 2,
+            Timestamp);
+
+    private static QueryListingDocument CreateDocument(
+        IReadOnlyList<QueryContactDocument> contacts,
+        IReadOnlyList<QueryMediaDocument> media) =>
+        QueryListingDocument.Create(
+            Guid.Parse("0198fb00-0000-7000-8000-000000000030"),
+            Guid.Parse("0198fb00-0000-7000-8000-000000000031"),
+            Guid.Parse("0198fb00-0000-7000-8000-000000000032"),
+            Guid.Parse("0198fb00-0000-7000-8000-000000000033"),
+            QueryListingKind.Place,
+            [
+                new QueryLocalizedDocument(
+                    "de-DE",
+                    "/de-DE/listings/studio",
+                    "Studio",
+                    QueryFieldState.Missing,
+                    null),
+            ],
+            ["recording-studio"],
+            [],
+            new QueryGeographyDocument(
+                QueryGeographyState.PrimaryMarket,
+                52.5m,
+                13.4m,
+                "mitte"),
+            contacts,
+            media,
+            new string('a', 64),
+            Timestamp);
+
+    private static QueryMediaDocument CreateMedia(Guid mediaId) =>
+        new(
+            mediaId,
+            $"https://media.example.test/{mediaId:N}.webp",
+            "image/webp",
+            new string('b', 64),
+            QueryMediaRightsBasis.OwnerProvided);
+}
