ARG DOTNET_SDK_IMAGE
ARG DOTNET_RUNTIME_IMAGE

FROM ${DOTNET_SDK_IMAGE} AS build
ARG PROJECT_PATH
ARG APP_DLL
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY . .
RUN test -n "${PROJECT_PATH}" \
    && test -n "${APP_DLL}" \
    && dotnet restore "${PROJECT_PATH}" \
    && dotnet publish "${PROJECT_PATH}" \
        --configuration "${BUILD_CONFIGURATION}" \
        --no-restore \
        --output /out/app \
        /p:UseAppHost=false \
        /p:ContinuousIntegrationBuild=true \
    && test -f "/out/app/${APP_DLL}"

FROM ${DOTNET_RUNTIME_IMAGE} AS runtime
ARG APP_DLL
ENV APP_DLL=${APP_DLL}
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends imagemagick \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/app/ ./
COPY deploy/entrypoint.sh /usr/local/bin/aggregator-entrypoint
RUN chmod 0555 /usr/local/bin/aggregator-entrypoint \
    && test -f "/app/${APP_DLL}"
USER $APP_UID
ENTRYPOINT ["/usr/local/bin/aggregator-entrypoint"]
