# Pin every image to an approved immutable digest before production deployment.
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.302
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.10
POSTGRES_IMAGE=postgres:17-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z

POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=

CATALOG_DB=catalog_db
CATALOG_MIGRATOR_USER=catalog_migrator
CATALOG_MIGRATOR_PASSWORD=
CATALOG_APP_USER=catalog_app
CATALOG_APP_PASSWORD=

QUERY_DB=query_db
QUERY_MIGRATOR_USER=query_migrator
QUERY_MIGRATOR_PASSWORD=
QUERY_APP_USER=query_app
QUERY_APP_PASSWORD=

INGESTION_DB=ingestion_db
INGESTION_MIGRATOR_USER=ingestion_migrator
INGESTION_MIGRATOR_PASSWORD=
INGESTION_APP_USER=ingestion_app
INGESTION_APP_PASSWORD=

ANALYTICS_DB=analytics_db
ANALYTICS_MIGRATOR_USER=analytics_migrator
ANALYTICS_MIGRATOR_PASSWORD=
ANALYTICS_APP_USER=analytics_app
ANALYTICS_APP_PASSWORD=

PROMOTION_DB=promotion_db
PROMOTION_MIGRATOR_USER=promotion_migrator
PROMOTION_MIGRATOR_PASSWORD=
PROMOTION_APP_USER=promotion_app
PROMOTION_APP_PASSWORD=

RABBITMQ_USER=aggregator
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=aggregator-storage
MINIO_ROOT_PASSWORD=
MINIO_CATALOG_BUCKET=catalog-artifacts
MINIO_INGESTION_BUCKET=ingestion-quarantine

OIDC_AUTHORITY=https://identity.example/realms/aggregator
OIDC_REQUIRE_HTTPS_METADATA=true
INGESTION_CATALOG_BEARER_TOKEN=

CATALOG_API_PORT=7101
QUERY_API_PORT=7102
INGESTION_API_PORT=7103
ANALYTICS_API_PORT=7104
PROMOTION_API_PORT=7105
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
