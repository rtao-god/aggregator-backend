# Copy to .env and replace every CHANGE_ME value before any state-changing Compose command.
# Production deployment must replace image tags with approved immutable digests.
# Local DB and RabbitMQ passwords are interpolated into connection strings; use URL-safe unreserved characters.

DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.302
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.10
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime:10.0.10
POSTGIS_IMAGE=postgis/postgis:18-3.6
RABBITMQ_IMAGE=rabbitmq:4.3.1-management-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.29
CLAMAV_IMAGE=clamav/clamav:1.5.2
CADDY_IMAGE=caddy:2.11.4-alpine

POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN
CATALOG_MIGRATOR_PASSWORD=CHANGE_ME_CATALOG_MIGRATOR
CATALOG_APP_PASSWORD=CHANGE_ME_CATALOG_APP
QUERY_MIGRATOR_PASSWORD=CHANGE_ME_QUERY_MIGRATOR
QUERY_APP_PASSWORD=CHANGE_ME_QUERY_APP
INGESTION_MIGRATOR_PASSWORD=CHANGE_ME_INGESTION_MIGRATOR
INGESTION_APP_PASSWORD=CHANGE_ME_INGESTION_APP
ANALYTICS_MIGRATOR_PASSWORD=CHANGE_ME_ANALYTICS_MIGRATOR
ANALYTICS_APP_PASSWORD=CHANGE_ME_ANALYTICS_APP
PROMOTION_MIGRATOR_PASSWORD=CHANGE_ME_PROMOTION_MIGRATOR
PROMOTION_APP_PASSWORD=CHANGE_ME_PROMOTION_APP

RABBITMQ_USER=aggregator
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
RABBITMQ_EVENTS_EXCHANGE=aggregator.events

OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=aggregator-local
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_OBJECT_STORAGE_SECRET_AT_LEAST_32_CHARACTERS
CATALOG_ARTIFACT_BUCKET=catalog-artifacts
CATALOG_MEDIA_BUCKET=catalog-media
INGESTION_BUCKET=ingestion-packages

AUTHENTICATION_AUTHORITY=https://identity.example/realms/aggregator
AUTHENTICATION_REQUIRE_HTTPS_METADATA=true
INGESTION_CATALOG_TOKEN_ENDPOINT=https://identity.example/realms/aggregator/protocol/openid-connect/token
INGESTION_CATALOG_CLIENT_ID=ingestion-worker
INGESTION_CATALOG_CLIENT_SECRET=CHANGE_ME_INGESTION_CATALOG_CLIENT_SECRET
INGESTION_CATALOG_SCOPE=catalog.ingestion
ASPNETCORE_ENVIRONMENT=Development

CATALOG_MEDIA_SYSTEM_ACTOR_ID=0198b000-0000-7000-8000-000000000001
PROMOTION_SYSTEM_ACTOR_ID=0198b000-0000-7000-8000-000000000002

BACKEND_HTTP_PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=
